#!/bin/sh
# Keep the CPUs within what the Limeboard's weakest power source can carry.
#
# The Limeboard has no battery: the CiSoM runs from the board's supply alone,
# and nothing absorbs a current peak. A radio powering up (the modem when
# rmtfs starts, the Wi-Fi firmware when it recovers from a crash) while the
# four CPUs run at full speed draws more than the input holds: the system
# voltage collapses and the PMIC cuts the power (power-on reason SMPL,
# previous power-off UVLO).
#
# One budget serves both operating modes, so a board can move between them
# without reconfiguration. It is set for the weakest source, Debug mode
# (powered by the host computer's USB port); Default mode, on USB-C PD or
# PoE, has more headroom.
#
# The limit is a power budget for the CPUs as a whole, set on the "package"
# node of the powercap DTPM zone; the kernel picks the CPU frequencies that
# fit it, rounding down to a step of the CPU energy model. Override it in
# /etc/default/citronics-power-budget:
#   CPU_BUDGET_UW=<microwatts>   0 leaves the CPUs unlimited
#
# 3.31 W holds the four CPUs at 1574 MHz. In Debug mode, load plus a Wi-Fi
# firmware restart survived at 1728 MHz and browned out at 1958 MHz; the
# default stays one step below what survived.
set -u

CPU_BUDGET_UW=3310000
[ -r /etc/default/citronics-power-budget ] && . /etc/default/citronics-power-budget

package_zone() {
	for z in /sys/class/powercap/dtpm:*; do
		[ "$(cat "$z/name" 2>/dev/null)" = package ] && { echo "$z"; return 0; }
	done
	return 1
}

if ! zone=$(package_zone); then
	echo "No DTPM package zone (kernel without CPU power capping): CPUs not limited."
	exit 0
fi

if [ "$CPU_BUDGET_UW" -eq 0 ]; then
	cat "$zone/constraint_0_max_power_uw" > "$zone/constraint_0_power_limit_uw"
	echo "CPU power not limited."
else
	echo "$CPU_BUDGET_UW" > "$zone/constraint_0_power_limit_uw"
	echo "CPU power limited to $CPU_BUDGET_UW uW."
fi
