#!/bin/sh
set -e
if [ "$1" = configure ]; then
	# Images before 2026-11 configured only the release itself, without
	# its security and stable updates: set those up, as images now do.
	if ! grep -rqsE -- '-security' /etc/apt/sources.list /etc/apt/sources.list.d/ &&
	   [ -r /etc/os-release ]; then
		. /etc/os-release
		case "$ID" in
		debian)
			cat > /etc/apt/sources.list.d/debian.sources <<SOURCES
Types: deb
URIs: https://deb.debian.org/debian
Suites: $VERSION_CODENAME $VERSION_CODENAME-updates
Components: main non-free-firmware
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg

Types: deb
URIs: https://security.debian.org/debian-security
Suites: $VERSION_CODENAME-security
Components: main non-free-firmware
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg
SOURCES
			;;
		ubuntu)
			cat > /etc/apt/sources.list.d/ubuntu.sources <<SOURCES
Types: deb
URIs: http://ports.ubuntu.com/ubuntu-ports
Suites: $VERSION_CODENAME $VERSION_CODENAME-updates $VERSION_CODENAME-security
Components: main universe
Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg
SOURCES
			;;
		esac
		if [ -f "/etc/apt/sources.list.d/$ID.sources" ] && [ -f /etc/apt/sources.list ]; then
			mv /etc/apt/sources.list /etc/apt/sources.list.citronics-old
		fi
		echo "citronics-lime: security updates enabled; run apt update && apt full-upgrade"
	fi
	# Packages built for one distribution release, such as the patched
	# ModemManager, are published in a suite named after its codename.
	# Images configure it; older installations get it here.
	if [ -r /etc/os-release ]; then
		. /etc/os-release
		case "$VERSION_CODENAME" in
		trixie|resolute)
			if ! grep -lsr 'citronics\.github\.io/deb-packages' /etc/apt/sources.list /etc/apt/sources.list.d/ |
			     xargs -r grep -qsw -- "$VERSION_CODENAME"; then
				cat > "/etc/apt/sources.list.d/citronics-$VERSION_CODENAME.sources" <<SOURCES
Types: deb
URIs: https://citronics.github.io/deb-packages
Suites: $VERSION_CODENAME
Components: main
Trusted: yes
SOURCES
				echo "citronics-lime: added the Citronics $VERSION_CODENAME suite; run apt update && apt full-upgrade"
			fi
			;;
		esac
	fi
	# The SIM selection unit images installed in /etc would hide this
	# package's: replace it, keeping the service enabled.
	f=/etc/systemd/system/msm-modem-uim-selection.service
	if [ -f "$f" ] && [ "$(md5sum < "$f" | cut -d' ' -f1)" = "e8910f2062084589226c62015e89a368" ]; then
		rm -f "$f" /etc/systemd/system/multi-user.target.wants/msm-modem-uim-selection.service
		[ -d /run/systemd/system ] && systemctl daemon-reload >/dev/null 2>&1 || true
		systemctl enable msm-modem-uim-selection.service >/dev/null 2>&1 || true
	fi
	# The USB gadget setup was image files in /etc, which would hide this
	# package's: replace each one that is exactly as an image shipped it,
	# and keep the service enabled if it was. Edited copies stay.
	gadget_enabled=""
	f=/etc/systemd/system/usb-gadget.service
	if [ -f "$f" ]; then
		case "$(md5sum < "$f" | cut -d' ' -f1)" in
		48127da532239fb445da0b37c235ba9b|885c4ef2607b12fad466db508fe9a24d|94774115e0216503de26e70b8b01b32f|fe0f2df1c7deeab8cc08a5b85c640dbc)
			[ -L /etc/systemd/system/multi-user.target.wants/usb-gadget.service ] && gadget_enabled=1
			rm -f "$f" /etc/systemd/system/multi-user.target.wants/usb-gadget.service
			;;
		esac
	fi
	f=/etc/udev/rules.d/80-usb-gadget.rules
	if [ -f "$f" ] && [ "$(md5sum < "$f" | cut -d' ' -f1)" = "37dbacfbd01740273424ffa03d1c20a4" ]; then
		rm -f "$f"
	fi
	if [ ! -f /etc/systemd/system/usb-gadget.service ] && command -v deb-systemd-helper >/dev/null; then
		# Enabled on a new installation (images) and where the image had it
		# enabled; otherwise as the administrator left it
		if [ -z "$2" ] || [ -n "$gadget_enabled" ] ||
		   deb-systemd-helper --quiet was-enabled usb-gadget.service; then
			deb-systemd-helper enable usb-gadget.service >/dev/null || true
		else
			deb-systemd-helper update-state usb-gadget.service >/dev/null || true
		fi
	fi
	[ -d /run/systemd/system ] && systemctl daemon-reload >/dev/null 2>&1 || true
	[ -d /run/udev ] && udevadm control --reload >/dev/null 2>&1 || true
	# The modem setup units: attach APN and LTE preference before
	# ModemManager, LTE once registered
	if command -v deb-systemd-helper >/dev/null; then
		for unit in msm-modem-attach-apn.service msm-modem-lte-once.service; do
			# Enabled when first seen (installation, or upgrade from a
			# version without it); otherwise as the administrator left it
			if ! deb-systemd-helper debian-installed "$unit" ||
			   deb-systemd-helper --quiet was-enabled "$unit"; then
				deb-systemd-helper enable "$unit" >/dev/null || true
			else
				deb-systemd-helper update-state "$unit" >/dev/null || true
			fi
		done
	fi
	# isc-dhcp-server6 has no interface to serve on these boards and fails
	# at every boot; images built since 2.2 disable it.
	if [ -d /run/systemd/system ]; then
		systemctl disable --now isc-dhcp-server6.service >/dev/null 2>&1 || true
	else
		systemctl disable isc-dhcp-server6.service >/dev/null 2>&1 || true
	fi
	# Apply the watchdog settings of system.conf.d without a reboot
	[ -d /run/systemd/system ] && systemctl daemon-reload >/dev/null 2>&1 || true
fi
exit 0
